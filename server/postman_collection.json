{
  "info": {
    "name": "Darija Translator API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "user",
      "value": "student"
    },
    {
      "key": "password",
      "value": "darija2026"
    }
  ],
  "item": [
    {
      "name": "Health (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Translate – English to Darija (Arabic script)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/translator/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "translator",
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"How are you? I hope everything is fine.\",\n  \"source\": \"English\",\n  \"script\": \"arabic\"\n}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Translate – French to Darija (Latin script)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/translator/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "translator",
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"On se voit demain au café ?\",\n  \"source\": \"French\",\n  \"script\": \"latin\"\n}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Translate – GET with query",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/translator/translate?text=Good%20morning&script=arabic",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "translator",
            "translate"
          ],
          "query": [
            {
              "key": "text",
              "value": "Good%20morning"
            },
            {
              "key": "script",
              "value": "arabic"
            }
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Who am I",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/translator/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "translator",
            "me"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "401 – no credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/translator/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "translator",
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"hello\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "401 – wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/translator/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "translator",
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"hello\"\n}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "student",
              "type": "string"
            },
            {
              "key": "password",
              "value": "wrong",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "400 – empty text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/translator/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "translator",
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"   \"\n}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{user}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}